# Server-side inference configuration for the M4 dev proxy.
# Copy to app/server/.env and fill in keys LOCALLY. The real .env is
# gitignored and is read only by the Node dev-server process; keys are
# never bundled, logged, or sent to the browser/Quest client.
# NEVER commit a populated .env. NEVER paste keys into chat.

# Active provider: meta | baseten | stub (blank = auto: meta, else baseten, else stub)
INFERENCE_PROVIDER=

# --- Meta Model API (direct) ---
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL_PRIMARY=muse-spark-1.3
META_MODEL_COMPARATOR=

# --- Baseten (official sponsor, Muse Spark Open) ---
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026

# Spend brake: max proxied model requests per dev-server process
# (in production, per warm Vercel function instance).
MAX_PROXY_REQUESTS=120
# Production public-demo kill switch: set to 0 in Vercel to disable
# /api/chat, /api/stt, and /api/tts without taking down the site.
PUBLIC_DEMO_ENABLED=1
# --- Fireworks AI (DORMANT - prepared 2026-10-27, NO live calls authorized yet) ---
# OpenAI-compatible. Model id per docs.fireworks.ai (Muse Spark Open).
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/models/muse-spark-open

# --- Wit.ai speech-to-text (voice input, owner-approved 2026-10-31) ---
# Server-side only; the Quest client posts 16 kHz WAV to /api/stt.
# Create a Wit app, paste its Server Access Token here.
WIT_API_TOKEN=
# To switch providers (after owner approves spend): set INFERENCE_PROVIDER
# to meta, baseten, or fireworks above. Keys for other providers may stay.
